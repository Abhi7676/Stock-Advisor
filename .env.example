# ════════════════════════════════════════════════════
# F&O AI Signal Advisor — Environment Variables
# ════════════════════════════════════════════════════
# Copy this to .env and fill in your values.
# On Render: set these in Dashboard → Environment.

# ─── Gemini AI (Required) ─────────────────────────
# Get free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── Database (Production) ───────────────────────
# Neon PostgreSQL connection string (from neon.tech)
# Leave blank to use local SQLite fallback
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# ─── Telegram Bot Alerts (Recommended, Free) ─────
# Step 1: Message @BotFather on Telegram → /newbot → copy token
# Step 2: Message @userinfobot on Telegram → copy your chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321

# ─── Gmail Email Alerts (Free) ────────────────────
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: myaccount.google.com → Security → App passwords → create one
# The App Password is 16 chars like: abcd efgh ijkl mnop (remove spaces)
ALERT_EMAIL_FROM=yourgmail@gmail.com
ALERT_EMAIL_TO=youremail@gmail.com
ALERT_EMAIL_PASSWORD=abcdefghijklmnop
