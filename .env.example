# ════════════════════════════════════════════════════
# F&O AI Signal Advisor — Environment Variables
# ════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# On Render: set these in Dashboard → Environment.

# ─── Gemini AI (Required) ─────────────────────────
# Get free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── Database (Production) ───────────────────────
# Neon PostgreSQL connection string (from neon.tech)
# Leave blank to use local SQLite fallback
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# ─── Telegram Alerts (Free — Recommended) ────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the Bot Token
# Step 2: Message @userinfobot on Telegram → copy your Chat ID (a number)
# Step 3: Start your bot once: search the bot name → send /start
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321
